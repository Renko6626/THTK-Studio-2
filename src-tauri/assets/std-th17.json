    },
    {
      "opcode": 12,
      "name": "rockingMode",
      "params": [
        {
          "name": "mode",
          "type": "int"
        }
      ],
      "description": "设置摇晃模式并重置摇晃计时器为0。不同游戏有不同模式，0为禁用摇晃。"
    },
    {
      "opcode": 13,
      "name": "bgColor",
      "params": [
        {
          "name": "color",
          "type": "int"
        }
      ],
      "description": "设置一个背景颜色，用于 IDirect3DDevice8::Clear 调用。颜色格式为 0xAARRGGBB，thstd 也支持 #RRGGBBAA 写法。"
    },
    {
      "opcode": 14,
      "name": "sprite",
      "params": [
