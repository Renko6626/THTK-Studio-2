          "name": "slot",
          "type": "int"
        },
        {
          "name": "script_index",
          "type": "int"
        },
        {
          "name": "layer",
          "type": "int"
        }
      ],
      "description": "加载一个2D精灵，用于天空盒等。StB–WBaWC 中有8个槽位(0-7)。layer 参数与ANM的层类似但独立。层数低的对象会先绘制。"
    },
