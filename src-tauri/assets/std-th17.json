{
  "tool": "thstd",
  "version": "17",
  "instructions": [
    {
      "opcode": 0,
      "name": "stop",
      "params": [],
      "description": "停止执行脚本。这类似于在脚本中放置一个无限大的时间标签。时间插值的值会继续更新，并且可以随时触发中断。"
    },
    {
      "opcode": 1,
      "name": "jmp",
      "params": [
        {
          "name": "time",
          "type": "int"
        },
        {
          "name": "offset",
          "type": "int"
        }
      ],
      "description": "跳转到脚本开头偏移量为 offset 的指令，并将当前时间设置为 time。"
    },
    {
      "opcode": 2,
      "name": "pos",
      "params": [
        {
          "name": "x",
          "type": "float"
        },
        {
          "name": "y",
          "type": "float"
        },
        {
          "name": "z",
          "type": "float"
        }
      ],
      "description": "设置摄像机的位置。"
    },
    {
