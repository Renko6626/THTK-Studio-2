diff --git a/tests/msg_encoding.rs b/tests/msg_encoding.rs
new file mode 100644
index 0000000..7e7996f
--- /dev/null
+++ b/tests/msg_encoding.rs
@@ -0,0 +1,29 @@
+use std::fs;
+use std::process::Command;
+
+#[test]
+fn gbk_stage_and_ending_roundtrip_without_changing_default_encoding() {
+    let dir = tempfile::tempdir().unwrap();
+    let input = dir.path().join("input.spec");
+    for (opcode, ending) in [(17, false), (3, true)] {
+        fs::write(&input, format!("meta {{table: {{0: {{script: \"main\"}}}}}}\nscript main {{ ins_{opcode}(\"汉\"); }}")).unwrap();
+        let binary = dir.path().join("output.msg");
+        let restored = dir.path().join("restored.spec");
+        let run = |mode: &str, source: &std::path::Path, target: &std::path::Path, encoding: Option<&str>| {
+            let mut cmd = Command::new(env!("CARGO_BIN_EXE_truth-core"));
+            cmd.args(["trumsg", mode, "-g", "18", "-o"]).arg(target).arg(source);
+            if ending { cmd.arg("--ending"); }
+            if let Some(encoding) = encoding { cmd.args(["--encoding", encoding]); }
+            cmd.env_remove("TRUTH_MAP_PATH").output().unwrap()
+        };
+        let encoded = run("compile", &input, &binary, Some("gbk"));
+        assert!(encoded.status.success(), "{}", String::from_utf8_lossy(&encoded.stderr));
+        // GBK 汉 = BA BA; existing MSG XOR mask starts 77,7E,95,BC.
+        assert!(fs::read(&binary).unwrap().windows(4).any(|w| w == [0xcd,0xc4,0x95,0xbc]));
+        assert!(run("decompile", &binary, &restored, Some("gbk")).status.success());
+        assert!(fs::read_to_string(&restored).unwrap().contains("汉"));
+        assert!(!run("compile", &input, &binary, None).status.success());
+        fs::write(&input, format!("meta {{table: {{0: {{script: \"main\"}}}}}}\nscript main {{ ins_{opcode}(\"😀\"); }}")).unwrap();
+        assert!(!run("compile", &input, &binary, Some("gbk")).status.success());
+    }
+}
