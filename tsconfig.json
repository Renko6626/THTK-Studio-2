{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // 迁移已完成：src/ 与 tests/ 下不再有 .js。关掉 allowJs 后，
    // 任何新增的 .js 都会以"找不到模块"的形式立刻暴露。
    "allowJs": false,
    "types": ["vite/client"]
  },
  // 全部纳入。SFC 需标 lang="ts" 才会被检查（EmptyEditorState.vue 是纯模板、无 script）。
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}
