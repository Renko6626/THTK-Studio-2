{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // 迁移期间保留：src/ 下还剩 main.js，Task 13 收口时关掉。
    // checkJs 始终为 false —— 未标 lang="ts" 的 SFC 也走这条路径，
    // 它们要逐个加 lang="ts" 才真正进入门禁。
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client"]
  },
  // .vue 已纳入，但只有标了 lang="ts" 的 SFC 才会被真正检查。
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}
