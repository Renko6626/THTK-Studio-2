{
  // 这三个目录都是 gitignored 的生成物，加起来轻松超过 Linux 默认的
  // fs.inotify.max_user_watches（65536）。配额一旦被 VS Code 吃满，
  // Vite dev server 和 Tauri CLI 都会以 "OS file watch limit reached" 失败，
  // 而报错信息完全看不出真正的原因。
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/src-tauri/target/**": true
  },
  // 同样的目录也没必要出现在搜索结果里
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/src-tauri/target": true
  }
}
